App(
    appid="loader",
    apptype=FlipperAppType.METAPACKAGE,
)

App(
    appid="menu_viewer",
    name="MenuView",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="menu_viewer_app",
    requires=["gui", "storage"],
    stack_size=4 * 1024,
    fap_category="Tools",
    sources=["viewer/menu_viewer.c"],
)

